{
  "name": "levonis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "lint": "eslint .",
    "check": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p tests/tsconfig.json && eslint . && npm run check:workspaces && npm run check:boundaries && npm run check:studio",
    "check:workspaces": "node scripts/check-workspaces.mjs",
    "check:boundaries": "tsx --test tests/serviceBoundaries.test.ts tests/leastPrivilege.test.ts tests/boundariesBindings.test.ts tests/boundariesEvents.test.ts tests/ownership.test.ts tests/eventSchemas.test.ts tests/edgeParity.test.ts tests/monorepo.test.ts tests/workflowNaming.test.ts tests/coreOutbox.test.ts tests/darkDeployOrder.test.ts",
    "check:studio": "node scripts/check-studio.mjs",
    "deploy": "echo 'Skipping deploy in preview environment'",
    "deploy:staging": "node scripts/set-deploy-ids.mjs --env staging && wrangler deploy --env staging",
    "deploy:production": "node scripts/set-deploy-ids.mjs --env production && wrangler deploy --env=\"\"",
    "db:migrate:local": "wrangler d1 migrations apply levonis-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply levonis-db --remote",
    "test:unit": "node scripts/test-all.mjs",
    "test:workspaces": "node scripts/test-workspaces.mjs"
  },
  "dependencies": {
    "@levonis/pricing": "*",
    "@react-oauth/google": "^0.13.5",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "hono": "^4.9.0",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "ogl": "^1.0.11",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.2.3",
    "wrangler": "^4.30.0"
  }
}