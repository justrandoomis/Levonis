{
  "name": "levonis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "build": "node scripts/prepare-deploy-config.mjs && vite build && node scripts/write-asset-headers.mjs",
    "lint": "eslint .",
    "check": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p tests/tsconfig.json && eslint . && npm run check:studio",
    "check:studio": "node scripts/check-studio.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "node scripts/set-deploy-ids.mjs --env staging && wrangler deploy --env staging",
    "deploy:production": "node scripts/set-deploy-ids.mjs --env production && wrangler deploy --env=\"\"",
    "db:migrate:local": "wrangler d1 migrations apply levonis-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply levonis-db --remote",
    "test:unit": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "hono": "^4.9.0",
    "jsqr": "^1.4.0",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "ogl": "^1.0.11",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.2.3",
    "wrangler": "^4.30.0"
  }
}
