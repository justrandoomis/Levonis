{
  // Cloudflare Workers configuration for LEVO Studio (studio.levonis-iq.com).
  //
  // Completely separate from the store worker ("levonis" / root wrangler.jsonc):
  // its own worker name, its own D1 database and R2 bucket, its own deploy
  // workflows (.github/workflows/deploy-studio-*.yml). The store's database and
  // bucket are NEVER bound here — Studio only stores project data keyed by an
  // opaque owner_id (docs/STUDIO_PLAN.md, decision 4).
  //
  // The *-PLACEHOLDER values are substituted at deploy time by
  // studio/scripts/set-deploy-ids.mjs from the GitHub Actions workflows;
  // no real IDs are committed. Local development ignores them.
  //
  // Build/deploy flow: the @cloudflare/vite-plugin reads THIS file as its
  // input, and `vinext build` (npm run build) emits the deployable config to
  // dist/ plus a .wrangler/deploy/config.json redirect. Select the target with
  // CLOUDFLARE_ENV=staging at build time; `wrangler deploy --env staging`
  // then deploys the built worker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "levonis-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Built client assets. HTML is always rendered by the worker (vinext SSR),
  // so every document response carries the COOP/COEP security headers set in
  // worker/index.ts — the static-asset fast path never serves HTML here.
  // /api/* and /auth/* must reach the worker even if a static file ever
  // shadows them (same convention as the store's run_worker_first).
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  // Image optimization for /_vinext/image (see worker/index.ts).
  "images": { "binding": "IMAGES" },

  // Studio-only project database. Migrations are generated by drizzle-kit
  // into ./drizzle (see studio/db) and applied by the deploy workflows.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "levonis-studio-db",
      "database_id": "STUDIO-PROD-DB-ID-PLACEHOLDER",
      "migrations_dir": "drizzle"
    }
  ],

  // Private project-file storage. Never public, never signed URLs — every
  // read streams through the worker after a D1 ownership check.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "levonis-studio-files"
    }
  ],

  // Non-secret runtime configuration, passed by the deploy workflows via
  // --var (wrangler replaces plain-text vars wholesale on every deploy).
  // APP_ORIGIN: Studio's own trusted origin (return-URL validation, cookies).
  // MAIN_SITE_ORIGIN: the main-site worker origin used for the server-to-
  // server handoff-code exchange. Empty = handoff honestly disabled.
  // Secrets (e.g. the handoff exchange secret) are uploaded with
  // `wrangler secret put` by the workflows — never committed.
  "vars": {
    "APP_ORIGIN": "",
    "MAIN_SITE_ORIGIN": ""
  },

  "observability": { "enabled": true },

  // No cron triggers yet. The orphan-upload cleanup cron (STUDIO_PLAN
  // decision 4, step CLEANUP) is added here together with the worker's
  // `scheduled` handler once the storage API lands — deploying a cron without
  // a handler would fail at runtime, not honestly no-op.
  "triggers": { "crons": [] },

  "env": {
    // Staging: fully separate worker + D1 + R2 on workers.dev. Never attached
    // to the production domain and never sharing production data.
    "staging": {
      "name": "levonis-studio-staging",
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "not_found_handling": "none",
        "run_worker_first": ["/api/*", "/auth/*"]
      },
      "images": { "binding": "IMAGES" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "levonis-studio-db-staging",
          "database_id": "STUDIO-STAGING-DB-ID-PLACEHOLDER",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "levonis-studio-files-staging"
        }
      ],
      "vars": {
        "APP_ORIGIN": "",
        "MAIN_SITE_ORIGIN": ""
      },
      "observability": { "enabled": true },
      "triggers": { "crons": [] }
    }
  }
}
