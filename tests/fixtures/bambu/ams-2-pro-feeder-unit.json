  "html": "<!-- Îİ¸²¼¾Ö -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_t-stpc\"><!-- µÚһÌõ -->\n<div class=\"pct_st-p\">\n<h3 class=\"pct_st\">Overview</h3>\n<p class=\"pct_p\">The AMS 2 Pro Feeder Unit is specially designed to support the AMS 2 Pro for printing multiple colors and materials. Ceramic-reinforced antiwear bushings are embedded in each feeder inlet to better protect the inlet from being worn by the filament after prolonged use. Each AMS 2 Pro has 4 feeder units, and each feeder unit has its own motor and gears to actively push the filament forward or wind it back to the spool.The AMS 2 Pro Feeder Unit has a sensor to detect filament. When a filament is inserted, the feeder unit will feed the filament automatically. When a filament needs to be wound back, the feeder unit will drive the AMS 2 Pro active support shaft to rotate the spool for filament winding.</p>\n<p class=\"pct_p\">&nbsp;</p>\n</div>\n<!-- µÚÈýÌõ -->\n<div class=\"pct_st-p\">\n<h3 class=\"pct_st\">Installation</h3>\n<p class=\"pct_p\">Learn more about the AMS 2 Pro Feeder Unit on <a href=\"https://e.bambulab.com/t?c=KmIPXAm57Frt6xli\" target=\"_blank\" rel=\"noopener\">Bambu Lab Wiki</a>.</p>\n<p class=\"pct_p\">&nbsp;</p>\n</div>\n<!-- µÚËÄÌõ -->\n<div class=\"pct_st-p\">\n<h3 class=\"pct_st\">In the Box</h3>\n<p class=\"pct_p\"><span>- AMS 2 Pro Feeder Unit *1</span></p>\n<p class=\"pct_p\"><span>- BT2-8 Screw *2</span></p>\n<p class=\"pct_p\">&nbsp;</p>\n</div>\n<!-- µÚÎåÌõ -->\n<div class=\"pct_st-p\">\n<h3 class=\"pct_st\">Compatibility</h3>\n<p class=\"pct_p\">AMS 2 Pro</p>\n<p class=\"pct_p\">&nbsp;</p>\n</div>\n<div class=\"pct pct_mc\"><!-- table²¼¾Ö -->\n<div class=\"pct pct_mc\">\n<h3 class=\"pct_t\" style=\"text-align: center;\">Product Specifications</h3>\n<div class=\"pct_t-tb\">\n<table class=\"pct_tb\"><!-- ±íͷ -->\n<tbody><!-- µÚһÐÐ --><!-- µڶþÐÐ -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\"><b>Materials</b></td>\n<td class=\"pct_td\">Plastic, Metal</td>\n<td class=\"pct_td\"><b>Packaging Size</b></td>\n<td class=\"pct_td\">100*135*45 mm</td>\n</tr>\n<!-- µÚÈýÐÐ -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\"><b>Color</b></td>\n<td class=\"pct_td\">Grey</td>\n<td class=\"pct_td\"><b>Packaging Weight</b></td>\n<td class=\"pct_td\">0.147 kg</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n</div>\n<p><button id=\"paste-helper-id\" style=\"width: 0px; height: 0px; padding: 0px; margin: 0px; border: 0px; display: none;\"></button><button id=\"paste-helper-id\" style=\"width: 0px; height: 0px; padding: 0px; margin: 0px; border: 0px; display: none;\"></button></p>"
 },
