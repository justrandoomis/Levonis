  "html": "<!-- 第一条 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\" style=\"text-align: center;\">0.2mm Nozzle - Optimal Print Fineness</h2>\n<p class=\"pct_p\" style=\"text-align: center;\">Smaller diameter extrudes thin filaments<br />High resolution on the horizontal print surface</p>\n</div>\n<div class=\"pct_ic\"><!-- 手机端图片 --> <img class=\"pct_mi\" src=\"https://store.bblcdn.com/s7/default/6202d2884d7e4617a479cd81a8e12fde/Frame_1123861589_e5086170-c614-44e3-a462-ff82d30d6de6.png\" alt=\"图片加载失败文案\" /> <!-- PC端图片 --> <img class=\"pct_i\" src=\"https://store.bblcdn.com/s7/default/6202d2884d7e4617a479cd81a8e12fde/Frame_1123861589_e5086170-c614-44e3-a462-ff82d30d6de6.png\" alt=\"图片加载失败文案\" /></div>\n</div>\n</div>\n<!-- 第二条 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\"></div>\n</div>\n<h2 class=\"pct_t\" style=\"text-align: center;\">0.6mm and 0.8mm Nozzle - Faster Print Speed</h2>\n<p class=\"pct_p\" style=\"text-align: center;\">Larger diameter extrudes more filaments per second, resulting in faster print speed</p>\n</div>\n<!-- 图片部分 -->\n<div class=\"pct_ic\" style=\"flex: 3;\"><!-- 手机端图片 -->\n<p><video style=\"width: 100%;\" src=\"https://store.bblcdn.com/s1/default/7b14b991ad6946ceba3313b567372d5c/hotend_video_replace.mp4\" controls=\"controls\" width=\"300\" height=\"150\" autoplay=\"autoplay\" loop=\"loop\" muted=\"\" playsinline=\"\" poster=\"https://store.bblcdn.com/s7/default/5196b969aa394ec39d4f27f64e8bf829/20230605-152224.jpg\" data-mce-style=\"width: 100%;\" data-mce-src=\"https://store.bblcdn.com/s1/default/7b14b991ad6946ceba3313b567372d5c/hotend_video_replace.mp4\"></video></p>\n</div>\n<p></p>\n<!-- 第三条 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_tpc-ic\">\n<div class=\"pct_t-p\">\n<h2 class=\"pct_t\"></h2>\n</div>\n</div>\n<!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"pct_t\" style=\"text-align: center;\">Comparison of Different Nozzle Sizes</h2>\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\"><!-- 表头 -->\n<thead class=\"pct_th\">\n<tr>\n<td class=\"pct_td\"></td>\n<td class=\"pct_td\"><strong>0.2 mm Nozzle</strong></td>\n<td class=\"pct_td\"><strong>0.4 mm Nozzle</strong></td>\n<td class=\"pct_td\"><strong>0.6 mm Nozzle</strong></td>\n<td class=\"pct_td\"><strong>0.8 mm Nozzle</strong></td>\n</tr>\n</thead>\n<tbody><!-- 第一行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\"><strong>Usage scenario</strong></td>\n<td class=\"pct_td\">Perfect for small and <br />intricate models, with precision <br />that's worth the wait</td>\n<td class=\"pct_td\">Ideal for everyday use <br />with the perfect balance <br />of speed and quality</td>\n<td class=\"pct_td\">Faster speeds and capable <br />of printing high-performance filaments, <br />with some decrease in resolution</td>\n<td class=\"pct_td\">Faster speeds and capable <br />of printing high-performance filaments, <br />with some decrease in resolution</td>\n</tr>\n<!-- 第二行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\"><strong>Commonly used for</strong></td>\n<td class=\"pct_td\">Miniature models<br />Intricate logos<br />Text<br />Molds</td>\n<td class=\"pct_td\">Toys<br />Mechanical parts<br />Decorative objects</td>\n<td class=\"pct_td\">Large structural parts<br />Functional parts for household<br />Industrial or engineering parts<br />High-strength models</td>\n<td class=\"pct_td\">Large structural parts<br />Functional parts for household<br />Industrial or engineering parts<br />High-strength models</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n<div class=\"pct_ic\"><!-- 手机端图片 --> <img class=\"pct_mi\" src=\"https://store.bblcdn.com/s7/default/99ff3d053b3b4631bb7ced58ead266b2/Frame_1123861664.png\" alt=\"图片加载失败文案\" /> <!-- PC端图片 --> <img class=\"pct_i\" src=\"https://store.bblcdn.com/s7/default/99ff3d053b3b4631bb7ced58ead266b2/Frame_1123861664.png\" alt=\"图片加载失败文案\" /></div>\n</div>\n<div class=\"pct_ic\"><!-- 手机端图片 --> <img class=\"pct_mi\" src=\"https://store.bblcdn.com/s7/default/184253b3984143c19a3ac869916567e9/Group_47937.png\" alt=\"图片加载失败文案\" /> <!-- PC端图片 --> <img class=\"pct_i\" src=\"https://store.bblcdn.com/s7/default/184253b3984143c19a3ac869916567e9/Group_47937.png\" alt=\"图片加载失败文案\" /></div>\n<b>*The final display of 'Model Strength' &amp; 'Model Fineness' depends on the results of the material testing.</b></div>\n</div>\n<p><br /><br /></p>\n<!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"pct_t\" style=\"text-align: center;\">Filament Compatibility</h2>\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\"><!-- 表头 -->\n<thead class=\"pct_th\">\n<tr>\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>Material</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><strong>0.2 mm Nozzle</strong></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\"><strong>0.4 mm Nozzle</strong></td>\n<td class=\"pct_td\" style=\"width: 100.605px;\"><strong>0.6 mm Nozzle</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><strong>0.8 mm Nozzle</strong></td>\n<td class=\"pct_td\" style=\"width: 71.875px;\"><strong>Hardened Steel Required?</strong></td>\n</tr>\n</thead>\n<tbody><!-- 第一行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>General PLA</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Optional</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>PLA Sparkle</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span style=\"color: #ff2a00;\"><strong>*①NO</strong></span></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\"><span>YES</span></td>\n<td class=\"pct_td\" style=\"width: 100.605px;\"><span>YES</span></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span>YES</span></td>\n<td class=\"pct_td\" style=\"width: 71.875px;\"><span>Optional</span></td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>PLA Marble</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span style=\"color: #ff2a00;\"><strong>*①NO</strong></span></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\"><span>YES</span></td>\n<td class=\"pct_td\" style=\"width: 100.605px;\"><span>YES</span></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span>YES</span></td>\n<td class=\"pct_td\" style=\"width: 71.875px;\"><span>Optional</span></td>\n</tr>\n<!-- 第二行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>Wood/Rock/Metal-filled PLA</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span style=\"color: #ff2a00;\"><strong>*①NO</strong></span></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Optional</td>\n</tr>\n<!-- 第四行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>PETG</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Optional</td>\n</tr>\n<!-- 第五行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>PVA</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Optional</td>\n</tr>\n<!-- 第六行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>ABS</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Optional</td>\n</tr>\n<!-- 第七行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>ASA</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Optional</td>\n</tr>\n<!-- 第八行 --> <!-- 第九行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>PC</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Optional</td>\n</tr>\n<!-- 第十行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>PA</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span style=\"color: #ff2a00;\"><strong>*①NO</strong></span></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Optional</td>\n</tr>\n<!-- 第十一行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>TPU</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span style=\"color: #ff2a00;\"><strong>*①NO</strong></span></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Optional</td>\n</tr>\n<!-- 第十二行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>Bambu PLA-CF</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span style=\"color: #ff2a00;\"><strong>*①NO</strong></span></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\"><strong>*②Recommended</strong></td>\n<td class=\"pct_td\" style=\"width: 100.605px;\"><span>YES</span></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Required</td>\n</tr>\n<!-- 第十三行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>Bambu PETG-CF</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span style=\"color: #ff2a00;\"><strong>*①NO</strong></span></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\"><strong>*②Recommended</strong></td>\n<td class=\"pct_td\" style=\"width: 100.605px;\"><span>YES</span></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Required</td>\n</tr>\n<!-- 第十四行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>Bambu PAHT-CF</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span style=\"color: #ff2a00;\"><strong>*①NO</strong></span></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\"><strong>*③Recommended</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Required</td>\n</tr>\n<!-- 第十五行 -->\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>Bambu PET-CF</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span style=\"color: #ff2a00;\"><strong>*①NO</strong></span></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 100.605px;\"><strong>*③Recommended</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Required</td>\n</tr>\n<tr class=\"pct_tr\">\n<td class=\"pct_td\" style=\"width: 133.672px;\"><strong>CF/GF Filaments from other brands</strong></td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span style=\"color: #ff2a00;\"><strong>*①NO</strong></span></td>\n<td class=\"pct_td\" style=\"width: 101.621px;\"><span>Not Recommended</span></td>\n<td class=\"pct_td\" style=\"width: 100.605px;\">YES</td>\n<td class=\"pct_td\" style=\"width: 48.7695px;\"><span>YES</span></td>\n<td class=\"pct_td\" style=\"width: 71.875px;\">Required</td>\n</tr>\n</tbody>\n</table>\n<br /><strong>[*Note]</strong></div>\n<br />\n<div class=\"pct_tbc\"></div>\n<div class=\"pct_tbc\"></div>\n<div class=\"pct_tbc\"><strong></strong></div>\n<div class=\"pct_tbc\"><span style=\"font-size: 0.875rem;\"></span></div>\n<div class=\"pct_tbc\"><span style=\"font-size: 0.875rem;\"><span style=\"color: #ff2a00;\"><strong>*①</strong></span> Filaments with carbon fiber, glass fiber, metal, or other inorganic particles are prone to clog a </span><strong style=\"font-size: 0.875rem;\">0.2 mm nozzle</strong><span style=\"font-size: 0.875rem;\">.</span></div>\n<br />\n<div class=\"pct_tbc\"></div>\n<div class=\"pct_tbc\"></div>\n<div class=\"pct_tbc\"><span style=\"font-size: 0.875rem;\"><strong style=\"font-size: 0.875rem;\"><span data-mce-fragment=\"1\">*② Bambu PLA-CF </span></strong>and<strong style=\"font-size: 0.875rem;\"><span data-mce-fragment=\"1\">&nbsp;Bambu PETG-CF </span></strong>have been extensively tested and proven to have a low risk of clogging when printed with a <strong style=\"font-size: 0.875rem;\">hardened steel 0.4 mm nozzle</strong>, while also achieving higher print quality.</span></div>\n<br />\n<div class=\"pct_tbc\"></div>\n<div class=\"pct_tbc\"></div>\n<div class=\"pct_tbc\"><span style=\"font-size: 0.875rem;\"><strong>*③</strong> For general carbon fiber or glass fiber filaments such as Bambu PAHT-CF and PET-CF, it is</span><strong style=\"font-size: 0.875rem;\">&nbsp;recommended</strong><span style=\"font-size: 0.875rem;\"> to use a </span><strong style=\"font-size: 0.875rem;\">hardened steel</strong><span style=\"font-size: 0.875rem;\">&nbsp;</span><strong style=\"font-size: 0.875rem;\">0.6 mm nozzle</strong><span style=\"font-size: 0.875rem;\"> to minimize the risk of clogging and abrasion.</span></div>\n</div>\n</div>\n<div class=\"pct pct_mc\"></div>\n<div class=\"pct pct_mc\">Learn more about filament compatibility on <strong><span style=\"color: #00ae42;\"><a style=\"color: #00ae42;\" href=\"https://wiki.bambulab.com/en/general/filament-guide-material-table\" target=\"_blank\" rel=\"noopener\">Bambu Lab Wiki</a></span></strong>.</div>\n<br />\n<div class=\"pct pct_mc\">\n<div class=\"pct_tbc\" style=\"text-align: left;\"><span style=\"font-size: 0.875rem;\">Learn more about replacing the hotend with nozzle on </span><a href=\"https://wiki.bambulab.com/en/a1-mini/maintenance/toolhead\" target=\"_blank\" rel=\"noopener\"><strong><span style=\"color: #00ae42;\"><u>Bambu Lab Wiki</u></span></strong></a><span style=\"font-size: 0.875rem;\">.</span></div>\n</div>\n</div>\n<div class=\"pct pct_mc\">\n<div class=\"pct_t-stpc\">\n<div class=\"pct_st-p\" style=\"margin-top: 30px;\">\n<div class=\"pct pct_mc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-p\" style=\"margin-top: 30px;\">\n<h3 class=\"pct_st\" style=\"text-align: left;\">In the Box</h3>\n<p class=\"pct_p\" style=\"text-align: left;\">- Hotend with Nozzle<br /><br /></p>\n</div>\n<!-- 第五条 -->\n<div class=\"pct_st-p\" style=\"margin-top: 30px;\">\n<h3 class=\"pct_st\" style=\"text-align: left;\">Compatibility</h3>\n<p class=\"pct_p\" style=\"text-align: left;\">A1 Series</p>\n</div>\n</div>\n</div>\n</div>\n<br /><!-- table布局 -->\n<div class=\"pct pct_mc\">\n<div class=\"pct_st-tbc\">\n<h2 class=\"pct_t\" style=\"text-align: center;\">Product Specifications</h2>\n<div class=\"pct_tbc\">\n<table class=\"pct_tb\" style=\"height: 38px;\"><!-- 表头 -->\n<tbody><!-- 第一行 -->\n<tr class=\"pct_tr\" style=\"height: 19px;\">\n<td class=\"pct_td\" style=\"height: 19px; width: 192.305px;\"><strong>Max. Printing Temp.</strong></td>\n<td class=\"pct_td\" style=\"height: 19px; width: 59.7656px;\">320 ℃</td>\n<td class=\"pct_td\" style=\"height: 19px; width: 141.406px;\"><strong>Length</strong></td>\n<td class=\"pct_td\" style=\"height: 19px; width: 123.32px;\">47.3 mm</td>\n</tr>\n<!-- 第二行 -->\n<tr class=\"pct_tr\" style=\"height: 19px;\">\n<td class=\"pct_td\" style=\"height: 19px; width: 192.305px;\"><strong>Packaging Weight</strong></td>\n<td class=\"pct_td\" style=\"height: 19px; width: 59.7656px;\"><span>30 g</span></td>\n<td class=\"pct_td\" style=\"height: 19px; width: 141.406px;\"><strong>Packaging Size</strong></td>\n<td class=\"pct_td\" style=\"height: 19px; width: 123.32px;\">60*60*30 mm</td>\n</tr>\n<!-- 第三行 --></tbody>\n</table>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>"
 },
