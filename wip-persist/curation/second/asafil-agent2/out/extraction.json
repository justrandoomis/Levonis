 "featuresTitle": "Product Features",
 "features": [
  {
   "title": "Product Features",
   "html": "<div style=\"text-align: left; box-sizing: border-box;\">\n<div data-page-id=\"XQp2da9ZDoBR0fx29PGcd0Z7nNc\" data-lark-html-role=\"root\" data-docx-has-block-data=\"false\">\n<div data-page-id=\"XQp2da9ZDoBR0fx29PGcd0Z7nNc\" data-lark-html-role=\"root\" data-docx-has-block-data=\"false\">\n<ul style=\"margin: 0px; padding: 0px; list-style-position: inside; text-align: left; white-space: normal; box-sizing: border-box;\">\n<li style=\"box-sizing: border-box;\">Extraordinary UV Resistance</li>\n<li style=\"box-sizing: border-box;\">Exceptional Temperature Resistance</li>\n<li style=\"box-sizing: border-box;\">High Impact Strength and Durability</li>\n<li style=\"box-sizing: border-box;\">Outdoor Use for Long-Term Purpose</li>\n<li style=\"box-sizing: border-box;\">Comes with High Temperature Reusable Spool</li>\n<li style=\"box-sizing: border-box;\">Diameter: 1.75mm +/- 0.03mm</li>\n</ul>\n</div>\n</div>\n</div>\n<p>&nbsp;</p>\n<div class=\"bbl-title-4 text-bbl-grey-13 font-bold\">Cautions for Use</div>\n<ul style=\"margin: 0px; padding: 0px; margin-top: 8px; list-style-position: inside; text-align: left; white-space: normal; box-sizing: border-box;\">\n<li style=\"box-sizing: border-box;\">AMS 2 Pro, AMS HT &amp; AMS Compatible</li>\n<li style=\"box-sizing: border-box;\">AMS lite <strong>NOT </strong>Compatible</li>\n<li style=\"box-sizing: border-box;\">Enclosure Printers Required</li>\n</ul>"
  }
 ],
