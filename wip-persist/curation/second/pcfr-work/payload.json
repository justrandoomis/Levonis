  {
   "id": "cb_ce44833749d6bd179bcea1db",
   "order": 5,
   "title_en": "Engineering-Level Mechanical Properties",
   "body_en": "Bambu PC FR is an engineering-grade material with toughness comparable to PAHT-CF. Its exceptional stiffness and strength make it a top choice for structural components and protective casings.",
   "url": "",
   "source_media_id": "",
   "source_url": "",
