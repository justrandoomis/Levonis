     "id": "content_block_1776744740718_dwoqb1p7t",
     "type": "content_block",
     "variant": "content-block-21-pro",
     "name": "FAQ",
     "anchor": {
      "enabled": true,
      "name": "Printing Tips",
      "id": "content_block_1776744740718_dwoqb1p7t"
     },
     "modules": {
      "typeStyles": {
       "content": {
        "title": "Printing Tips"
       }
      },
      "featureConfig": {
       "faqs": [
        {
         "question": "1.Accessory Compatibility",
         "answerBlocks": [
          {
           "type": "rich-text",
           "content": "<div>Not compatible with <strong>Cool Plate SuperTack and AMS lite</strong>.</div>",
           "id": "comp_1789716119203_nspmapzg3"
          }
         ],
         "id": "comp_1789716119203_qrzc1ycam"
        },
        {
         "question": "2.Drying Recommendations",
         "answerBlocks": [
          {
           "type": "rich-text",
           "content": "<div>As this filament is highly moisture-absorbent, please place any unused filament in a sealed container with desiccant immediately, and dry thoroughly before printing. For more details, please refer to: <a href=\"https://wiki.bambulab.com/en/filament-acc/filament/dry-filament\" target=\"_blank\" rel=\"noopener\"><span style=\"text-decoration: underline;\"><span style=\"color: #00ae42; text-decoration: underline;\">Filament drying instructions</span></span></a> on WIKI.</div>",
           "id": "comp_1789716119203_h1g7edt8s"
          }
         ],
         "id": "comp_1789716119203_skdyib48r"
        },
        {
         "question": "3.Safety Tips",
         "answerBlocks": [
          {
           "type": "rich-text",
           "content": "<ul>\n<li>The nozzle temperature should be between 260-280&deg;C, and the heat bed temperature should be between 90-110&deg;C. Please ensure safety during printing.</li>\n<li>Please store the filament in a cool, dark, and dry environment away from direct sunlight and high temperatures.</li>\n<li>Please keep filament and any broken fragments out of reach of infants, children, and pets to prevent swallowing or choking.</li>\n<li>Please print this filament in a well-ventilated area, or install an effective air filtration or exhaust system.</li>\n<li>As this filament is not food-grade, please avoid using finished prints for food storage or contact.</li>\n</ul>",
           "id": "comp_1789716119203_8k3fcs5bo"
          }
         ],
         "id": "comp_1789716119203_75sogwsvc"
        }
       ]
      }
     }
    }
   ]
  }
