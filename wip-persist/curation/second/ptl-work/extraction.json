       "modules": {
        "typeStyles": {
         "content": {
          "title": "Bambu PLA Translucent",
          "description": "Bambu PLA Translucent, available in 10 vibrant colors, is perfect for crafting lightshades and decorative lanterns. Its frosted finish diffuses light beautifully. With enhanced durability, it’s ideal for long-term indoor lighting and décor. Customize the shape of light with Bambu PLA Translucent!"
         }
        },
