  },
  {
   "id": "cb_cc4b57698d36a221dccae57c",
   "order": 9,
   "title_en": "Starry Surface",
   "body_en": "The Starry Surface transfers a rainbow kaleidoscope starry effect on the first layer of the print, which glitters and changes color depending on the angle. It works best with silk or shiny filaments to take advantage of the pattern transfer.",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
   "alt_ar": "",
   "alt_ckb": "",
   "kind": "text",
   "section_kind": "overview",
   "section_path": "html › 4"
  },
  {
   "id": "cb_834ad4ee603fee2e2f15ec79",
   "order": 10,
   "title_en": "Diamond Surface",
   "body_en": "The Diamond Surface imprints a diamond pattern on the first layer with a mix of glossy and matte shapes applied to the smooth surface. It's best used with silk or shiny filaments, to take advantage of the pattern transfer.",
   "url": "",
   "source_media_id": "",
