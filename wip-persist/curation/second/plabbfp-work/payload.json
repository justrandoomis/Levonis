  {
   "id": "cb_6cd63cd47c9286358b8c9f76",
   "order": 9,
   "title_en": "Built Stronger, Faster and to Last Longer",
   "body_en": "With Bambu's exclusive fine-turned formulation based on 3D printing expertise and fine-turned settings, Bambu PLA Basic delivers stronger layer adhesion, enhanced impact resistance, and long-lasting durability compared to other standard PLA filaments on the market. Additionally, it reaches a print speed up to 258mm/s*, cutting your printing time without compromising quality.\n* 0.4mm nozzle, 0.4mm line width, 0.2mm layer height",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
   "alt_ar": "",
   "alt_ckb": "",
   "kind": "text",
