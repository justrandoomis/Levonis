       "modules": {
        "typeStyles": {
         "content": {
          "title": "Built Stronger, Faster and to Last Longer",
          "description": "With Bambu's exclusive fine-turned formulation based on 3D printing expertise and fine-turned settings, Bambu PLA Basic delivers stronger layer adhesion, enhanced impact resistance, and long-lasting durability compared to other standard PLA filaments on the market. Additionally, it reaches a print speed up to 258mm/s*, cutting your printing time without compromising quality.\n\n* 0.4mm nozzle, 0.4mm line width, 0.2mm layer height"
         }
        },
