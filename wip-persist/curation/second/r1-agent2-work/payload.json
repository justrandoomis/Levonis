 "product": {
  "title_en": "Bambu Lab R1",
  "short_description_en": "55W desktop CO2 laser cutter and engraver.",
  "variant_mode": "VARIANT_COMBINATION",
  "usage_steps": [
   {
    "title_en": "Tricky setup? Solved.",
    "body_en": "Usually, aligning the optical path meant test shots, manual adjustments, and trial and error — with no telling how long it might take. With R1, that chore comes down to one small sensor. Mount the Laser Alignment Sensor on the toolhead, and it measures the beam, detects the misalignment, and corrects the path automatically, in just one minute.\nR1 puts a touchscreen right on the machine. Follow every job in real time, watch the optical path calibrate, and check the machine's health status — all without a computer.\nR1 recognizes Bambu Lab material automatically and applies the right power and speed, so you can skip test grids and manual parameter setup."
   }
  ],
  "usage_official_url": ""
 },
