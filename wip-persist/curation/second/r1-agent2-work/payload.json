   "alt_ckb": "وێنەی Bambu Lab R1",
   "kind": "image",
   "section_kind": "features",
   "section_path": "components[3] › 1"
  },
  {
   "id": "cb_addeb2d8f2bce86e9b29fe7b",
   "order": 50,
   "title_en": "Safer by design. Made for everyday spaces.",
   "body_en": "Most lasers rely on a single exhaust fan. R1 brings fresh air in from one side and exhausts smoke from the other, creating a steady crossflow through the entire chamber.",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
   "alt_ar": "",
   "alt_ckb": "",
   "kind": "text",
   "section_kind": "features",
   "section_path": "components[4] › 1"
  },
  {
   "id": "cb_8c2a82023e341764bc5530c6",
   "order": 51,
   "title_en": "",
   "body_en": "",
   "url": "",
   "source_media_id": "content:aad6f1548c3758f3c4d82808",
   "source_url": "https://store.bblcdn.com/s7/kpwam/e7bee7cdea424135845d1db5059a2506/pc.mp4",
   "alt_en": "Bambu Lab R1",
   "alt_ar": "صورة Bambu Lab R1",
   "alt_ckb": "وێنەی Bambu Lab R1",
   "kind": "image",
   "section_kind": "features",
   "section_path": "components[4] › 1"
  },
  {
   "id": "cb_a40c28ce1825938ae0a6b202",
   "order": 52,
   "title_en": "Safer by design. Made for everyday spaces.",
   "body_en": "R1 is Class 1 under IEC 60825-1 in standard enclosed use. Laser radiation stays contained inside the enclosure, so no safety goggles or dedicated laser room are needed.⁷",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
   "alt_ar": "",
   "alt_ckb": "",
   "kind": "text",
