   "order": 43,
   "title_en": "",
   "body_en": "",
   "url": "",
   "source_media_id": "content:ad958a675ddfcdec95e7b498",
   "source_url": "https://store.bblcdn.com/s7/kpwam/0d2be898ff7f4f8188947dacbc735891/4_1.mp4",
   "alt_en": "Bambu Lab R1",
   "alt_ar": "صورة Bambu Lab R1",
   "alt_ckb": "وێنەی Bambu Lab R1",
   "kind": "image",
   "section_kind": "features",
   "section_path": "components[3] › 0"
  },
  {
   "id": "cb_88e7afb3dda5bd79911df18d",
   "order": 44,
   "title_en": "The motion control that keeps our printers precise. Now in R1.",
   "body_en": "When the toolhead changes direction, a split-second shake can ripple the line that follows. R1's vibration compensation cancels it out, keeping lines crisp right out of the turn — the same technology as in our 3D printers.",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
   "alt_ar": "",
   "alt_ckb": "",
   "kind": "text",
   "section_kind": "features",
   "section_path": "components[3] › 1"
  },
  {
   "id": "cb_c2906b6912c431521c53ca66",
   "order": 45,
   "title_en": "",
   "body_en": "",
   "url": "",
   "source_media_id": "content:ed7caae31b58a2f883c1a994",
   "source_url": "https://store.bblcdn.com/s7/kpwam/a63d605b0d1e4a33b48712050c86cb36/pcpc2.mp4",
   "alt_en": "Bambu Lab R1",
   "alt_ar": "صورة Bambu Lab R1",
   "alt_ckb": "وێنەی Bambu Lab R1",
   "kind": "image",
   "section_kind": "features",
   "section_path": "components[3] › 1"
  },
  {
   "id": "cb_00eff9daea84bc91f7ec5f00",
   "order": 46,
   "title_en": "The motion control that keeps our printers precise. Now in R1.",
   "body_en": "Higher speeds usually mean shallower engraving. R1 compensates as it moves, keeping engraving depth consistent at up to 1,000 mm/s — while completing the same job nearly 3× as fast.²",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
