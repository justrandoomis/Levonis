  },
  {
   "id": "cb_6cb2859a6b4f0a9190c0b967",
   "order": 42,
   "title_en": "What you mark is what you cut.",
   "body_en": "Cut around a printed design, trim a sticker, or follow a drawn outline. The Toolhead Camera traces the edge and keeps the cut precisely on path.",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
