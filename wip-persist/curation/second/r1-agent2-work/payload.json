   "alt_ar": "صورة Bambu Lab R1",
   "alt_ckb": "وێنەی Bambu Lab R1",
   "kind": "image",
   "section_kind": "features",
   "section_path": "components[3] › 0"
  },
  {
   "id": "cb_fa5f97eab3e4f029a867c4ff",
   "order": 36,
   "title_en": "What you mark is what you cut.",
   "body_en": "From curved cups and spheres to uneven surfaces. Height sensing follows every rise and fall to keep the engraving sharp and consistent across the entire surface.⁴",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
