  {
   "id": "cb_3115e4a1b31ba5022f36ec0d",
   "order": 34,
   "title_en": "What you mark is what you cut.",
   "body_en": "Drop in your workpiece — crooked, curved, or tiny. R1 locates it, reads the surface, and tracks every move as it works, so every line lands exactly where you set it. This is TriSense. What you mark is what you cut.",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
   "alt_ar": "",
   "alt_ckb": "",
   "kind": "text",
