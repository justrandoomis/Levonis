  },
  {
   "id": "cb_09b13c14caddc51299b9a000",
   "order": 38,
   "title_en": "What you mark is what you cut.",
   "body_en": "R1 keeps surface measurement accurate even on transparent materials like glass and clear acrylic, so engraving stays precisely placed.",
