  },
  {
   "id": "cb_414b64320afac512a71a410a",
   "order": 47,
   "title_en": "",
   "body_en": "",
   "url": "",
   "source_media_id": "content:d5388da1b105da434e081bbf",
   "source_url": "https://store.bblcdn.com/s7/kpwam/9cc4952d9f9443708d36dae0a9fedd7e/pc.mp4",
   "alt_en": "Bambu Lab R1",
   "alt_ar": "صورة Bambu Lab R1",
   "alt_ckb": "وێنەی Bambu Lab R1",
   "kind": "image",
   "section_kind": "features",
   "section_path": "components[3] › 1"
  },
  {
   "id": "cb_585a782324980c8ecf4b97e2",
   "order": 48,
   "title_en": "The motion control that keeps our printers precise. Now in R1.",
   "body_en": "Mechanical accuracy can drift with use. The Vision Encoder⁵ corrects for it, keeping absolute motion accuracy within 0.1 mm across the full work area. Draw 300 mm. Cut 300 mm.",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
   "alt_ar": "",
   "alt_ckb": "",
   "kind": "text",
