  {
   "id": "cb_5870e3503010e1dcf41057f1",
   "order": 71,
   "title_en": "FAQ",
   "body_en": "1.What are the differences between focusing lenses of different specifications?\n\n2.When does the R1 require optical path calibration?\n\n3.What are the differences in processing capabilities between the R1 and H2 series laser modules?\n\n4.Which materials are not recommended for processing?\n\n5.Which Bambu Lab air purifier is the R1 compatible with? Are older models compatible?",
   "url": "",
   "source_media_id": "",
   "source_url": "",
   "alt_en": "",
   "alt_ar": "",
   "alt_ckb": "",
   "kind": "text",
   "section_kind": "faq",
