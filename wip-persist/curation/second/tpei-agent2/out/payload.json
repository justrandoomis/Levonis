 "product": {
  "title_en": "Bambu Textured PEI Plate",
  "short_description_en": "The Bambu Textured PEI Plate is suitable for PLA, TPU, and PETG, as well as materials that require high temperatures like ABS and Nylon. It's a flexible magnetic build plate with sprayed dual-sided PEI coating. During printing, the plate will provide excellent adhesion and easy print removal after cooling.",
  "variant_mode": "VARIANT_COMBINATION",
  "usage_steps": [
   {
    "title_en": "Installation Steps for X1 Series/P1 Series/A1/P2S/X2D",
    "body_en": "Step 1: Align the plate with the fixed points of the platform with the name of the plate facing you\nStep 2: Lower the plate and secure to the magnetic platform"
   },
   {
    "title_en": "Installation Steps for A1 mini",
    "body_en": "Step 1: Align the plate with the fixed points of the platform with the name of the plate facing you\nStep 2: Lower the plate and secure to the magnetic platform"
   }
