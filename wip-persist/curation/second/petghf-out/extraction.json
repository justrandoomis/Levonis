   "html": "<div style=\"text-align: left; box-sizing: border-box;\">\n<div data-page-id=\"XQp2da9ZDoBR0fx29PGcd0Z7nNc\" data-lark-html-role=\"root\" data-docx-has-block-data=\"false\">\n<div data-page-id=\"XQp2da9ZDoBR0fx29PGcd0Z7nNc\" data-lark-html-role=\"root\" data-docx-has-block-data=\"false\">\n<ul style=\"margin: 0px; padding: 0px; list-style-position: inside; text-align: left; white-space: normal; box-sizing: border-box;\">\n<li style=\"box-sizing: border-box;\">Designed for Speed</li>\n<li style=\"box-sizing: border-box;\">Print Flawlessly with Minimal Tuning</li>\n<li style=\"box-sizing: border-box;\">Smooth, Soft Texture</li>\n<li style=\"box-sizing: border-box;\">Ready for Outdoor Use</li>\n<li style=\"box-sizing: border-box;\">Diameter: 1.75mm +/- 0.03mm</li>\n</ul>\n</div>\n</div>\n</div>\n<p>&nbsp;</p>\n<div class=\"bbl-title-4 text-bbl-grey-13 font-bold\">Cautions for Use</div>\n<ul style=\"margin: 0px; padding: 0px; margin-top: 8px; list-style-position: inside; text-align: left; white-space: normal; box-sizing: border-box;\">\n<li style=\"box-sizing: border-box;\">All AMS Series Compatible</li>\n<li style=\"box-sizing: border-box;\">Dry Out Before Use</li>\n</ul>\n<p style=\"margin-top: 0px; font-size: inherit; font-weight: inherit; margin-bottom: 0px; color: red; box-sizing: border-box;\">&nbsp;</p>\n<p><strong><span style=\"color: red;\">Note:</span></strong></p>\n<ul>\n<li style=\"font-size: inherit; font-weight: inherit; color: red; box-sizing: border-box;\">PETG HF must be dried before use to achieve optimal print quality.</li>\n<li style=\"font-size: inherit; font-weight: inherit; color: red; box-sizing: border-box;\">PETG HF is discontinued and will not be restocked once sold out. A new and improved PETG is available now!<span style=\"text-decoration: underline;\"> <span style=\"color: #00ae42; text-decoration: underline;\"><a style=\"color: #00ae42; text-decoration: underline;\" href=\"../../../products/petg-basic\">Buy Now &gt;</a></span></span></li>\n</ul>"
  }
 ],
