    {
     "id": "content_block_1776744740718_dwoqb1p7t",
     "type": "content_block",
     "variant": "content-block-21-pro",
     "name": "FAQ",
     "anchor": {
      "enabled": true,
      "name": "Printing Tips",
      "id": "content_block_1776744740718_dwoqb1p7t"
     },
     "modules": {
      "typeStyles": {
       "content": {
        "title": "Printing Tips"
       }
      },
      "featureConfig": {
       "faqs": [
        {
         "question": "1.Accessory Compatibility",
         "answerBlocks": [
          {
           "type": "rich-text",
           "content": "<div>Compatible with all printers, AMS, build plate, and nozzles.</div>",
           "id": "comp_1790040601598_01ta8jc0m"
          }
         ],
         "id": "comp_1790040601598_0j17amdiv"
        },
        {
         "question": "2.Drying Recommendations",
         "answerBlocks": [
          {
           "type": "rich-text",
           "content": "<div>Dry before use to ensure the best print quality and consistent finish. PETG HF must be dried before use and remain moisture-free during the printing process, especially for longer print times (over 6 hours). For more details, please refer to: <a href=\"https://wiki.bambulab.com/en/filament-acc/filament/dry-filament\" target=\"_blank\" rel=\"noopener\"><span style=\"text-decoration: underline;\"><span style=\"color: #00ae42; text-decoration: underline;\">Filament drying instructions</span></span></a> on WIKI.</div>",
           "id": "comp_1790040601598_jzjoh7jix"
          },
