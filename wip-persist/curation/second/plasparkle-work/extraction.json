       "modules": {
        "typeStyles": {
         "content": {
          "title": "Display of PLA Sparkle Prints",
          "description": "Bambu PLA Sparkle is a next-level aesthetic filament that combines strength and sparkle. With metal particles included in its composition, Bambu PLA Sparkle adds a special sparkling look to your prints that sets them apart from the rest.\n\nHowever, it is not recommended to use a 0.2 mm nozzle for printing as clogging may occur. Take your 3D printing projects to new heights with Bambu PLA Sparkle!"
         }
