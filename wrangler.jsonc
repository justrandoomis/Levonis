{
  // Cloudflare Workers configuration for Levonis.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  //
  // The *-PLACEHOLDER values are substituted at deploy time by the GitHub
  // Actions workflows from repository secrets (scripts/set-deploy-ids.mjs);
  // no real IDs are committed. Local development ignores them.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "levonis",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Built Vite frontend served as static assets with SPA fallback.
  // /api/* and /files/* always hit the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/files/*"]
  },

  // Top-level names double as the LOCAL dev identifiers (wrangler dev /
  // db:migrate:local). The production workflow swaps in the real
  // production name/id/bucket right before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "levonis-db",
      "database_id": "PROD-DB-ID-PLACEHOLDER",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "levonis-files"
    }
  ],

  // Non-secret runtime configuration. GOOGLE_CLIENT_ID and
  // INITIAL_ADMIN_EMAIL are passed by the deploy workflows via --var.
  // Secrets (TELEGRAM_BOT_TOKEN, optional GEMINI/EMAIL keys) are uploaded
  // with `wrangler secret put` by the workflows — never committed.
  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "INITIAL_ADMIN_EMAIL": "",
    "EXTRA_ALLOWED_ORIGINS": "",
    "APP_ORIGIN": "",
    "EMAIL_ALLOWED_RECIPIENTS": "",
    "EMAIL_FROM": "",
    // The root domain the host classifier measures every request against.
    // Declared here even though it is filled at deploy time: a name that is
    // not in this file is a name the Workers-Builds preservation pass cannot
    // see, and an unpreserved var is a wiped var.
    "STORE_ROOT_DOMAIN": "",
    // Declared for exactly the reason above. The Studio sign-in allowlist is
    // set at deploy time from a repository secret, and being absent here is
    // how it would be silently wiped by a build that preserves only the names
    // this file knows — after the owner had finally set it.
    "STUDIO_ALLOWED_DESTINATIONS": ""
  },

  "observability": { "enabled": true },

  // Durable jobs: outbox delivery (email/telegram), challenge expiry.
  // The scheduled handler is idempotent — overlapping runs are safe.
  "triggers": { "crons": ["*/15 * * * *"] },

  "env": {
    // Staging: fully separate Worker + D1 + R2. Deployed to workers.dev,
    // never to the production domain.
    "staging": {
      "name": "levonis-staging",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/files/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "levonis-db-staging",
          "database_id": "STAGING-DB-ID-PLACEHOLDER",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "levonis-files-staging"
        }
      ],
      "vars": {
        "GOOGLE_CLIENT_ID": "",
        "INITIAL_ADMIN_EMAIL": "",
        "EXTRA_ALLOWED_ORIGINS": "",
        "APP_ORIGIN": "",
        "EMAIL_ALLOWED_RECIPIENTS": "",
        "EMAIL_FROM": "",
        "STORE_ROOT_DOMAIN": "",
        // levonis-staging is the Worker that serves levonis-iq.com, so this
        // is the block that matters for the live site.
        "STUDIO_ALLOWED_DESTINATIONS": ""
      },
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/15 * * * *"] }
    }
  }
}
