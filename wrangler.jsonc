{
  // Cloudflare Workers configuration for Levonis.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  //
  // The *-PLACEHOLDER values are substituted at deploy time by the GitHub
  // Actions workflows from repository secrets (scripts/set-deploy-ids.mjs);
  // no real IDs are committed. Local development ignores them.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "levonis",
  "main": "worker/index.ts",
  /**
   * NEVER DELETE A VAR THIS FILE DID NOT MENTION.
   *
   * `wrangler deploy` replaces a Worker's plain-text vars WHOLESALE by default,
   * so any deploy carrying an incomplete config silently erases the rest. That
   * took Google sign-in, password reset, email verification and email sign-in
   * codes off the live shop on 2026-09-18 (see the note at `vars`, and
   * docs/AUTH_PROVIDERS.md §10).
   *
   * With this, wrangler leaves untouched any variable it is not explicitly
   * GIVEN. Deploys that DO mean to set a value still set it — workflow 7 passes
   * every one with --var — so nothing loses the ability to configure the
   * Worker; what is lost is the ability to blank it by OMISSION.
   *
   * ⚠ OMISSION IS ONLY HALF OF IT, and the other half cost a fourth outage the
   * same day. A var this file DECLARES as "" is a var wrangler is given, so it
   * is deployed and the live value is replaced by nothing — `keep_vars` does
   * not apply to it at all. The deploy at 13:12 carried this key and blanked
   * them anyway. The `vars` block below therefore names nothing it cannot fill,
   * and `scripts/lib/preserve-vars.mjs` drops any name that still resolves to
   * empty before wrangler sees it.
   *
   * TOP-LEVEL ONLY: wrangler refuses this key inside a named environment, so it
   * cannot be repeated in env.staging / env.dark and does not need to be.
   * `tests/deployVarsSurvive.test.ts` fails if it is removed, and fails again if
   * any vars block reintroduces an empty string.
   */
  "keep_vars": true,

  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Built Vite frontend served as static assets with SPA fallback.
  //
  // `run_worker_first` is the whole routing decision. Anything NOT listed here
  // is answered by the asset layer before the Worker exists for that request —
  // which is why the SPA document's security headers come from a generated
  // `dist/_headers` file and not from the Worker's own middleware
  // (packages/platform-kit/src/edge/securityPolicy.ts says so at length).
  //
  // /api/* and /files/* are the Worker's own surface.
  //
  // THE FOUR PRODUCT PATHS ARE HERE FOR ONE REASON: A SHARED LINK. They are
  // ordinary SPA routes and the asset layer could serve them, but then a
  // crawler — Telegram, WhatsApp, Instagram, Messenger — would read the shell
  // and unfurl the SHOP's card for every product in the catalogue, because a
  // crawler does not boot React. Running the Worker first lets it put the
  // product's own name, picture and description into the document before it
  // leaves (worker/lib/socialPreview.ts). The Worker passes every other
  // request on these prefixes straight through to the same assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/files/*",
      "/product/*",
      "/bundles/*",
      "/p/*",
      "/community/store/*"
    ]
  },

  // Top-level names double as the LOCAL dev identifiers (wrangler dev /
  // db:migrate:local). The production workflow swaps in the real
  // production name/id/bucket right before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "levonis-db",
      "database_id": "PROD-DB-ID-PLACEHOLDER",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "levonis-files"
    },
    {
      "binding": "R2_PUBLIC",
      "bucket_name": "levonis-media-public"
    },
    {
      "binding": "R2_PRIVATE",
      "bucket_name": "levonis-media-private"
    }
  ],

  /**
   * SERVER-SIDE IMAGE CONVERSION, so a picture does not depend on the phone it
   * was taken with.
   *
   * The conversion to WebP used to run in the BROWSER, on a canvas, and a
   * browser is not a place a rule can be enforced: `canvas.toBlob(cb,
   * 'image/webp')` is specified to fall back to PNG on a runtime with no WebP
   * encoder, silently, with a valid Blob. So the owner's own phone decided the
   * format, and on the wrong phone the answer was "converted" and the database
   * held a PNG.
   *
   * `env.IMAGES` is Cloudflare's Workers Images binding: it takes the BYTES the
   * Worker is already holding and returns WebP, the same way for every visitor.
   * The other mechanism — `fetch(url, { cf: { image } })` — cannot see bytes in
   * memory, and in this Worker it would re-enter itself through `/files/*` in
   * `run_worker_first` and fail; that is the live bug behind the hand-written
   * MEDIA_TRANSFORM_UNAVAILABLE fallback in routes/media.ts.
   *
   * NON-INHERITABLE, so it is repeated in every environment below. An
   * environment that omits it gets `env.IMAGES === undefined`, which
   * `worker/lib/imageConvert.ts` degrades on honestly rather than crashing —
   * but the point of declaring it here is that no environment has to.
   */
  "images": { "binding": "IMAGES" },

  // Non-secret runtime configuration.
  //
  // ⚠ THIS BLOCK MAY ONLY CONTAIN NAMES WITH A REAL VALUE. A name declared
  // here as "" is NOT "unset" — `wrangler deploy` sends it, and the live
  // Worker's value is replaced by the empty string. `keep_vars` does NOT
  // save it: wrangler's own schema says keep_vars keeps the vars it "is not
  // explicitly given", and a declared "" IS being given.
  //
  // That distinction cost the live shop Google sign-in, password reset, email
  // verification and email sign-in codes FOUR times on 2026-09-18. The last
  // one is the one that proves the rule: the deploy at 13:12 carried
  // `keep_vars: true` and still blanked them, because these names were still
  // declared "" below. Every time the signature was identical — vars off,
  // SECRETS still on (whatsappOtp stayed true), because secrets live in a
  // store `wrangler deploy` does not touch.
  //
  // So the rule now has two halves and needs both:
  //
  //   1. `keep_vars: true` (top of this file) — wrangler leaves alone any var
  //      it is not given, so a deploy can no longer erase by OMISSION.
  //   2. this block names nothing it cannot fill — so a deploy can no longer
  //      erase by DECLARATION either.
  //
  // The real values are supplied at deploy time: GitHub workflow 7 passes each
  // one with --var, and `scripts/prepare-deploy-config.mjs` merges the live
  // Worker's values on the Cloudflare Workers Builds path. That script's read
  // is best-effort — `await liveVars(cfg.name).catch(() => null)` — and in the
  // Workers Builds container it has no CLOUDFLARE_API_TOKEN to read with, so
  // it returns null every time and the merge falls back to what this file
  // declares. Which is why what this file declares must be nothing.
  //
  // `tests/deployVarsSurvive.test.ts` fails if an empty string appears in any
  // vars block, in any environment. See docs/AUTH_PROVIDERS.md §10.
  "vars": {
    // `off` makes an EMPTY allowlist mean "mail everybody" rather than "mail
    // NOBODY" (`worker/lib/outbox.ts` `allowedRecipient`). On the live Worker
    // the allowlist is a staging convenience and mail must reach real
    // customers. This is a real value, which is why it may be here.
    "EMAIL_ALLOWLIST_REQUIRED": "off"
  },

  "observability": { "enabled": true },

  // Durable jobs: outbox delivery (email/telegram), challenge expiry.
  // The scheduled handler is idempotent — overlapping runs are safe.
  "triggers": { "crons": ["*/15 * * * *"] },

  "env": {
    // Staging: fully separate Worker + D1 + R2. Deployed to workers.dev,
    // never to the production domain.
    "staging": {
      "name": "levonis-staging",
      // See the top-level `assets` block for why the product paths are here.
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/files/*",
          "/product/*",
          "/bundles/*",
          "/p/*",
          "/community/store/*"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "levonis-db-staging",
          "database_id": "STAGING-DB-ID-PLACEHOLDER",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "levonis-files-staging"
        },
        {
          "binding": "R2_PUBLIC",
          "bucket_name": "levonis-media-public-staging"
        },
        {
          "binding": "R2_PRIVATE",
          "bucket_name": "levonis-media-private-staging"
        }
      ],
      "images": { "binding": "IMAGES" },
      "vars": {
        // ONLY NAMES WITH A REAL VALUE — see the top-level `vars` note. Every
        // other name this block used to declare empty (GOOGLE_CLIENT_ID,
        // INITIAL_ADMIN_EMAIL, EXTRA_ALLOWED_ORIGINS, APP_ORIGIN,
        // EMAIL_ALLOWED_RECIPIENTS, EMAIL_FROM, STORE_ROOT_DOMAIN,
        // STUDIO_ALLOWED_DESTINATIONS) is set by the deploy workflow and kept
        // between deploys by `keep_vars`. levonis-staging is the Worker that
        // serves levonis-iq.com, so this is the block that took the live site
        // down four times.
        //
        // `off`: on the live Worker the allowlist is a staging convenience and
        // mail must reach real customers (`worker/lib/outbox.ts`
        // `allowedRecipient`).
        "EMAIL_ALLOWLIST_REQUIRED": "off"
      },
      "observability": { "enabled": true },
      "triggers": { "crons": ["*/15 * * * *"] }
    },

    // ------------------------------------------------------------------ dark
    // The DARK twin of the core (`02-MIGRATION-PLAN.md` slice 1.4). It is the
    // SAME code as env.staging with its OWN empty database and bucket, so the
    // gateway, the event bus and the four leaf consumers can be driven end to
    // end before anything live changes.
    //
    // NOTHING HERE IS DEPLOYED BY THIS SLICE. Creating `levonis-core-dark`,
    // `levonis-db-dark` and `levonis-files-dark` changes the Cloudflare account
    // and is gated on the owner (G1/G2). `svc-core-dark.yml` is the workflow
    // that does it, and it refuses to run until the Paid-plan precondition (D1)
    // is confirmed.
    //
    // Reachability: no `routes` here — routing lives in the dashboard
    // (`docs/WORKERS.md`), and the dark core is reached on the DARK ZONE
    // (`<darkroot>/*`, D21), never on workers.dev. `workers_dev` and
    // `preview_urls` are therefore both false: a Worker holding a seeded copy
    // of the whole product should not also answer on a second, unrouted door.
    "dark": {
      "name": "levonis-core-dark",
      // See the top-level `assets` block for why the product paths are here.
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/files/*",
          "/product/*",
          "/bundles/*",
          "/p/*",
          "/community/store/*"
        ]
      },
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "levonis-db-dark",
          "database_id": "DARK-DB-ID-PLACEHOLDER",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "levonis-files-dark"
        },
        {
          "binding": "R2_PUBLIC",
          "bucket_name": "levonis-media-public-dark"
        },
        {
          "binding": "R2_PRIVATE",
          "bucket_name": "levonis-media-private-dark"
        }
      ],
      "images": { "binding": "IMAGES" },
      "vars": {
        // ONLY NAMES WITH A REAL VALUE. See the top-level `vars` note: a name
        // declared here as "" is deployed as "" and overwrites whatever the
        // dark Worker is running with. The names this block used to declare
        // empty — GOOGLE_CLIENT_ID, INITIAL_ADMIN_EMAIL, EXTRA_ALLOWED_ORIGINS,
        // APP_ORIGIN, STORE_ROOT_DOMAIN, EMAIL_ALLOWED_RECIPIENTS, EMAIL_FROM,
        // STUDIO_ALLOWED_DESTINATIONS, CORE_SIGNING_PUBLIC_KEY,
        // ALLOWED_CALLER_KIDS, LEVONIS_VERSION — are all set by svc-core-dark.yml
        // at deploy time, and `keep_vars` keeps them between deploys.
        //
        // The dark stack must never be able to mail a real address, and
        // `EMAIL_ALLOWLIST_REQUIRED: "on"` is what makes that true rather than
        // merely intended: with it an EMPTY `EMAIL_ALLOWED_RECIPIENTS` means
        // "nobody" instead of "everybody", so the dark core mails no one until
        // the owner puts real dark addresses in it. Being absent from this file
        // is the same as being empty for that rule — `worker/lib/outbox.ts`
        // `allowedRecipient` reads `(env.EMAIL_ALLOWED_RECIPIENTS || '')` — so
        // the safety holds without the declaration.
        "EMAIL_ALLOWLIST_REQUIRED": "on",
        // Phase 1 (`worker/lib/types.ts` Env, slice 1.6). These exist here so
        // the dark stack can publish while the live core cannot.
        "EVENT_BUS_ENABLED": "on",
        "EVENT_BUS_MODE": "rpc",
        // off | log | on. `off` until one release after G3.
        "GATEWAY_ONLY": "off"
      },
      // The four dark leaf consumers (slice 1.7). They are bound ONLY here:
      // the live core binds nothing until G2, and `subscriptionsFor` narrows
      // the fan-out to the consumers a deployment can actually reach, so an
      // absent binding is simply not a subscriber.
      "services": [
        { "binding": "AUDIT", "service": "levonis-audit-dark" },
        { "binding": "ANALYTICS", "service": "levonis-analytics-dark" },
        { "binding": "ADS", "service": "levonis-ads-dark" },
        { "binding": "NOTIFICATIONS", "service": "levonis-notifications-dark" }
      ],
      "observability": { "enabled": true },
      // The same cadence as the live core (D5): the per-minute trigger is part
      // of the G2 change set, not of a dark deploy. `pumpAfter` in `waitUntil`
      // delivers what a request just committed, so the dark end-to-end proof
      // does not wait for a tick.
      "triggers": { "crons": ["*/15 * * * *"] }
    }
  }
}
