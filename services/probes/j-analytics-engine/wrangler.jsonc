{
  // ADR-017 (j) — does writing a data point create the dataset?
  // D22 calls this deploy-only: no dashboard action, no new token scope.
  // Deploying this probe is the test of that claim.
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "levonis-probe-ae",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "analytics_engine_datasets": [{ "binding": "PROBE_AE", "dataset": "levonis_probe_ae" }]
}
