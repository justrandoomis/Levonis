{
  // ADR-017 (c) — self-binding RPC. The `services` entry below names THIS
  // Worker, which is also why the two-step first deploy exists
  // (`scripts/resolve-ids.mjs`): the upload API rejects a binding to a Worker
  // that does not exist yet, and on the first deploy this Worker is that
  // Worker. Deploy once with the binding stripped, then again with it.
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "levonis-probe-selfbind",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "services": [
    { "binding": "SELF", "service": "levonis-probe-selfbind", "entrypoint": "ProbeEntrypoint" }
  ]
}
