{
  "step": "Leak audit 2026-10-10 (DECISIONS row 220) — a stranger reads final values only: no accessory buying price, no print margin or rate, no printer economics, no supplier picture link; Pricing V2 (spec §8): no V2 private key (v2_*, discount_usd, usd_ceil6, exact_iqd), no editor dollar block (editor_usd*, staff only) and no V2 flag on a product page",
  "vars": {
    "slug": {
      "from": "/api/products?limit=1",
      "pick": "products.0.slug"
    }
  },
  "probes": [
    {
      "path": "/api/print-quote/accessories",
      "status": [
        200
      ],
      "forbidKeys": "cost|iqd|price|margin|markup|profit"
    },
    {
      "path": "/api/marketplace/print/catalog",
      "status": [
        200
      ],
      "forbidKeys": "cost|margin|markup|profit|machine|setup_fee|per_hour|per_kg|break_even|failure_reserve|purchase|residual|maintenance|labou?r|electric|unit_iqd|^iqd$"
    },
    {
      "path": "/api/print-quote/printers",
      "status": [
        200
      ],
      "forbidKeys": "cost|iqd|purchase|residual|maintenance|useful_print_hours|baseline_success|margin|profit"
    },
    {
      "path": "/api/products/print-calculator",
      "status": [
        200
      ],
      "forbidKeys": "cost|margin|markup|profit|machine|setup_fee|per_hour|break_even"
    },
    {
      "path": "/api/settings/public",
      "status": [
        200
      ],
      "forbidKeys": "^(printServicePricing|printPricingConfig|printMaterials|printAccessories|minMarginPercent)$|margin_percent|setup_fee_iqd|machine_iqd_per_hour|cost_iqd"
    },
    {
      "path": "/api/home",
      "status": [
        200
      ],
      "forbidKeys": "^(printServicePricing|printPricingConfig|printMaterials|printAccessories|minMarginPercent)$|margin_percent|setup_fee_iqd|machine_iqd_per_hour|cost_iqd"
    },
    {
      "path": "/api/products/{slug}",
      "status": [
        200
      ],
      "valuePatterns": {
        "source_url": "^$"
      },
      "forbidKeys": "^v2_|^v2$|^editor_usd|discount_usd|deltas_usd|usd_ceil6|exact_iqd|^sku_strict$"
    },
    {
      "path": "/api/public/v1/products/{slug}",
      "status": [
        200
      ],
      "valuePatterns": {
        "source_url": "^$"
      },
      "forbidKeys": "^v2_|^v2$|^editor_usd|discount_usd|deltas_usd|usd_ceil6|exact_iqd|^sku_strict$"
    }
  ],
  "note": "Anonymous GETs only. `source_url` is held to the empty string wherever it appears: a picture's supplier link is the owner's (projectPublic blanks it; the public API v1 drops the key, and an absent key passes). The print-service rates and the accessory buying price left every public answer with DECISIONS row 220."
}
