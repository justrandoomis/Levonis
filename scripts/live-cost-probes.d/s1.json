        "price_iqd"
      ]
    },
    {
      "path": "/api/products/{slug}",
      "status": [
        200
      ],
      "forbidKeys": "cost|supplier|replacement|target|profit|margin|(premium|extra)_rule|(target|premium|extra)_rule_id|fx|exchange_rate_used|shipping_(rate|cost|weight|length|width|height|cbm)|rate_iqd|manual_cbm|effective_cbm|pricing_(weight|revision)|^pricing_mode$|MANUAL_OVERRIDE",
      "forbidPattern": "MANUAL_OVERRIDE|PRICING_PRIVATE",
      "requireIntegerKeys": [
        "price_iqd"
      ]
    },
    {
      "path": "/api/public/v1/products/{slug}",
      "status": [
        200
      ],
      "forbidKeys": "cost|supplier|replacement|target|profit|margin|(premium|extra)_rule|(target|premium|extra)_rule_id|fx|exchange_rate_used|shipping_(rate|cost|weight|length|width|height|cbm)|rate_iqd|manual_cbm|effective_cbm|pricing_(weight|revision)|^pricing_mode$|MANUAL_OVERRIDE",
      "forbidPattern": "MANUAL_OVERRIDE|PRICING_PRIVATE"
    },
    {
      "path": "/api/home",
      "status": [
        200
      ],
      "forbidKeys": "cost|supplier|replacement|target_profit|profit|(premium|extra)_rule|(target|premium|extra)_rule_id|fx_|exchange_rate_used|shipping_(rate|cost|weight|length|width|height|cbm)|rate_iqd|manual_cbm|effective_cbm|pricing_(weight|revision)|^pricing_mode$|MANUAL_OVERRIDE|margin_percent|setup_fee_iqd|machine_iqd_per_hour",
      "forbidPattern": "MANUAL_OVERRIDE|PRICING_PRIVATE",
      "note": "A bare `margin` is not forbidden here (a layout word could carry it); the print-service rates are, by name: since DECISIONS row 220 printServicePricing is no longer a public setting, so its margin_percent, setup_fee_iqd and machine_iqd_per_hour must never reach the home payload."
    }
  ],
  "note": "Anonymous GETs only (master plan §4.0). Key regexes are critique A9's; `pricing_mode` is anchored so the public `pricing_modes` (sale modes on a product page) is not mistaken for the private engine flag. A bare `rule_id` is NOT forbidden: the product page's `membership_preview.pro.rule_id` names the public PRO/PRIME discount rule a customer is shown, not a cost, and once PRO is resumed every product page carries it. The cost-rule ids (`target_rule_id`, `extra_rule_id` and its old name `premium_rule_id`, adminScope FINANCIAL_FIELDS) are forbidden by name."
}
