# Local development secrets for `wrangler dev` (copy to .dev.vars — that file
# is gitignored). Production secrets are set in the Cloudflare dashboard or
# with `wrangler secret put`, never committed.

# Optional: enables the admin translation tool locally.
# GEMINI_API_KEY=

# Optional: enables password-reset emails locally (Resend API key + sender).
# EMAIL_API_KEY=
# EMAIL_FROM=Levonis <noreply@example.com>

# Optional: IQWealth's keyed API — the Iraqi parallel-market USD/IQD the FX
# scheduler reads every 6 or 12 hours (FX programme plan §3). Without it the
# USD/IQD pair stays NOT_CONFIGURED; nothing else needs it. Never commit a
# real value; on the live Worker it is a dashboard SECRET.
IRAQ_PARALLEL_FX_API_KEY=

# Optional: the provider API key (Anthropic) of the support assistant AI layer (DECISIONS
# row 262). Without it the assistant stays in basic mode. Never commit a real
# value; on the live Worker it is a dashboard SECRET.
ANTHROPIC_API_KEY=

# Optional: the Creative Studio's vault key (DECISIONS row 270). It encrypts a
# provider key the owner types in the studio settings (AES-256-GCM); without it
# typing a key is refused and the studio uses ANTHROPIC_API_KEY when set.
# Format "v1:<base64 of 32 random bytes>" — e.g. `printf 'v1:%s' "$(openssl rand -base64 32)"`.
# Never commit a real value; on the live Worker it is a dashboard SECRET.
CREATIVE_STUDIO_ENC_KEY=

# The deception layer's HMAC key (worker/lib/deception/canary.ts) for the
# canary tokens in decoy answers, the signed device tag and the network keys.
# Without it a key is derived from TELEGRAM_WEBHOOK_SECRET (or
# STUDIO_HANDOFF_SECRET / TELEGRAM_ADMIN_WEBHOOK_SECRET); with none of them the
# decoys answer WITHOUT trap data and no tag is minted (there is no built-in
# key). Any value works locally. Never commit a real value; on the live Worker
# it is a dashboard SECRET that no workflow puts or deletes.
SECURITY_CANARY_KEY=

# Levonis Print Cloud (docs/PRINT_CLOUD.md §13.1). All optional.
# DEVELOPMENT ONLY: 'on' lets a customer pay their own order from the API
# (POST /api/print-cloud/v1/orders/:id/dev-pay). Never set it on a deployed Worker.
PRINT_CLOUD_DEV_PAYMENTS=
# HMAC secret (>= 32 chars) of the payment-gateway webhook; without it the
# gateway adapter is off. On the live Worker it is a dashboard SECRET.
PRINT_CLOUD_PAYMENT_WEBHOOK_SECRET=
# Signs short-lived model download links (>= 32 chars); without it signed
# links are refused and owners download directly.
PRINT_CLOUD_FILE_URL_SECRET=
